{
  "name": "poc-social-isw",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run start:elysia",
    "start:elysia": "bun run build && bun source/boot.elysia.ts",
    "dev": "bun run dev:elysia",
    "dev:elysia": "bun run --parallel dev:server:elysia dev:client dev:css",
    "build": "bun run build:client && bun run build:css",
    "build:client": "bun build source/infra/client/app.ts --outdir public/js --target browser",
    "build:css": "tailwindcss -i source/infra/styles/app.css -o public/css/app.css --minify",
    "dev:server:elysia": "bun --watch source/boot.elysia.ts",
    "dev:client": "bun build source/infra/client/app.ts --outdir public/js --target browser --watch",
    "dev:css": "tailwindcss -i source/infra/styles/app.css -o public/css/app.css --watch=always"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/html": "^1.4.1",
    "@elysia/static": "^1.4.11",
    "dockdi": "^1.0.4",
    "ejs": "^7.0.2",
    "elysia": "^1.4.30",
    "express": "^5.3.0",
    "geoip-lite": "^2.0.3",
    "ofetch": "^1.5.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
