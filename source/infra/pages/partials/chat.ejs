<%# The message list the client script fills as messages arrive, and the chat form under it. -%>
<section class="flex min-h-0 flex-1 flex-col gap-3.5">
  <div class="flex min-h-0 flex-1 flex-col">
    <%- include('empty-line', { id: 'chat-empty', text: 'No messages yet' }) %>
    <div id="chat-list" class="scroll-soft flex max-h-96 min-h-0 flex-col gap-4 overflow-y-auto lg:max-h-none lg:flex-1"></div>
  </div>
  <%- include('message-form', { id: 'chat', textPlaceholder: 'Write a message', sendLabel: 'Send' }) %>
</section>
